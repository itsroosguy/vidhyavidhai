# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=

# Supabase Publishable / Anon Key (safe for browser bundle; NEVER put service_role or sb_secret_* here)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: set to true only when Google OAuth provider is enabled in Supabase Auth
VITE_SUPABASE_GOOGLE_OAUTH_ENABLED=false

# Legacy Google Apps Script Web App Deployment URL (used only when Supabase env vars are unset)
VITE_APPS_SCRIPT_URL=

# Legacy Google Identity Services OAuth 2.0 Web Client ID (used only in non-Supabase mode)
VITE_GOOGLE_CLIENT_ID=

# Optional OAuth 2.0 Google Sheets serverless backend URL
VITE_SHEETS_BACKEND_URL=

# Optional programme timezone override (defaults to Asia/Kolkata)
VITE_PROGRAMME_TIMEZONE=Asia/Kolkata
